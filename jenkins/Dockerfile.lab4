FROM cafeteria-jenkins-devsecops:2.580.1
USER root
RUN curl -fsSL https://get.helm.sh/helm-v4.3.1-linux-amd64.tar.gz -o /tmp/helm.tar.gz \
    && echo '0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b  /tmp/helm.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/helm.tar.gz -C /usr/local/bin --strip-components=1 linux-amd64/helm \
    && rm /tmp/helm.tar.gz
RUN curl -fsSL --compressed https://downloads.snyk.io/cli/v1.1308.3/snyk-linux -o /usr/local/bin/snyk \
    && chmod 0755 /usr/local/bin/snyk \
    && snyk --version
COPY casc.lab4.yaml /usr/share/jenkins/casc-lab4.yaml
ENV CASC_JENKINS_CONFIG=/usr/share/jenkins/casc-lab4.yaml
USER jenkins
